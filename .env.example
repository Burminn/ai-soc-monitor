# Skopiuj do .env (plik .env jest w .gitignore). Nigdy nie commituj prawdziwych wartości.

# WYMAGANE, min. 32 znaki. Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SOC_SECRET_KEY=

# Domeny dla Caddy (docker-compose)
INGEST_DOMAIN=ingest.example.com
SOC_DOMAIN=soc.example.com

# Opcjonalne
# SOC_DEMO_MODE=0                  # 1 = formularz ręcznego wstrzykiwania zdarzeń (tylko demo)
# SOC_PRIVILEGED_ACTORS=admin,root,administrator
# SOC_SESSION_HOURS=8
